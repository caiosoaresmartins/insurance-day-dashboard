{
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/notion.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/kv.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/13o",
      "destination": "/index.html"
    },
    {
      "source": "/apresentacao",
      "destination": "/index.html"
    },
    {
      "source": "/presentation",
      "destination": "/index.html"
    },
    {
      "source": "/gestor",
      "destination": "/index.html"
    },
    {
      "source": "/painel",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ]
}
